name:               homepage
version:            0.1.0.0
build-type:         Simple
cabal-version:      >= 1.10

executable site
  main-is:          site.hs
  other-modules:    Pdf
  build-depends:    base == 4.*
                  , bytestring
                  , hakyll == 4.16.*
                  , diagrams-svg >= 1.4 && < 1.6
                  , diagrams-lib >= 1.4 && < 1.6
                  , network-uri
                  , pandoc >= 3.7 && < 4
                  , pandoc-types
                  , tagsoup
                  , text
                  , time
                  , transformers
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N
  default-language: Haskell2010
